# The production relay: what Crok releases and every build not marked as a test sign in to.
#
#   crok, Crok Desktop   make build / deploy / dmg-desktop, release/publish.sh (CROK_RELAY_ENV unset or prod)
#   phones               mobile/scripts/build-apps.sh prod: iOS Release + Android release, "-prod" on the Desktop
#   web + functions      relay/scripts/deploy.sh prod: the Vercel project below, Convex production deployment
#
# Read by crates/codegen/crok-remote/build.rs, mobile/Android/app/build.gradle.kts and the scripts above. One
# KEY=value per line, nothing quoted, no secrets: the Clerk keys live in the Vercel project, the device signing key
# on the Convex deployment.
CONVEX_DEPLOYMENT=tacit-finch-29
CONVEX_URL=https://tacit-finch-29.convex.cloud
WEB_URL=https://crok.chenli.dev
VERCEL_PROJECT=crok-relay-prod
CLERK_APP=app_3KkgYIdLrnpq5Da2b6GtTHFXvLy
CLERK_INSTANCE=production
CLERK_ISSUER=https://clerk.crok.chenli.dev
