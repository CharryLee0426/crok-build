        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "textMode": "value",
          "orientation": "auto",
          "wideLayout": true,
          "showPercentChange": false
