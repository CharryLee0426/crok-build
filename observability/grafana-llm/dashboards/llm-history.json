      },
      {
        "type": "timeseries",
        "title": "Claude cache reads per day",
        "description": "Share of Claude input tokens read from the prompt cache, per day. Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 12,
              "lineWidth": 2,
              "showPoints": "always",
              "spanNulls": true,
              "barAlignment": 0,
              "gradientMode": "opacity",
              "stacking": {
                "mode": "none",
                "group": "A"
              },
              "axisSoftMin": 0,
              "pointSize": 6
            },
            "color": {
              "mode": "palette-classic"
            },
            "min": 0,
            "max": 1
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "mean"
            ],
            "showLegend": true,
            "sortBy": "Mean",
            "sortDesc": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "transformations": [
          {
            "id": "renameByRegex",
            "options": {
              "regex": "^nil$",
              "renamePattern": "(not set)"
            }
          }
        ],
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${prom}"
            },
            "expr": "sum(sum_over_time(llm_tokens{provider=\"claude\",direction=\"cache_read\"}[$__interval] offset -$__interval)) / sum(sum_over_time(llm_tokens{provider=\"claude\",direction=\"input\"}[$__interval] offset -$__interval))",
            "legendFormat": "cache hit rate",
            "instant": false,
            "range": true,
            "editorMode": "code",
            "interval": "1d"
          }
        ],
        "interval": "1d",
        "id": 15,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 24
        }
      }
    ]
  }
}
