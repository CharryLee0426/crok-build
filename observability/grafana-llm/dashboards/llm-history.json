        },
        "transformations": [
          {
            "id": "renameByRegex",
            "options": {
              "regex": "^nil$",
              "renamePattern": "(not set)"
            }
          }
        ],
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${prom}"
            },
            "expr": "sum by (price_group) (sum_over_time(llm_spend_usd{provider=\"claude\"}[$__interval] offset -$__interval))",
            "legendFormat": "{{price_group}}",
            "instant": false,
            "range": true,
            "editorMode": "code",
            "interval": "1d"
          }
        ],
        "interval": "1d",
        "id": 10,
