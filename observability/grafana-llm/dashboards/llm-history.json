      {
        "type": "row",
        "title": "Where the money went",
        "collapsed": false,
        "panels": [],
        "id": 13,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 23
        }
      },
      {
        "type": "table",
        "title": "Spend by price group",
        "description": "Spend over the time range for each Claude price group and for OpenRouter, largest first. Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto",
              "cellOptions": {
                "type": "auto"
              }
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Field"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Price group"
                },
                {
                  "id": "custom.width",
                  "value": 230
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Last * (sum)"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Spend"
                },
                {
                  "id": "unit",
                  "value": "currencyUSD"
                },
                {
                  "id": "min",
                  "value": 0
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "gauge",
                    "mode": "basic",
                    "valueDisplayMode": "text"
                  }
                },
                {
                  "id": "decimals",
                  "value": 2
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "footer": {
            "show": false
          }
        },
        "transformations": [
          {
            "id": "renameByRegex",
            "options": {
              "regex": "^nil$",
              "renamePattern": "(not set)"
            }
          },
          {
            "id": "reduce",
            "options": {
              "reducers": [
                "lastNotNull"
              ],
              "mode": "seriesToRows"
            }
          },
          {
            "id": "groupBy",
            "options": {
              "fields": {
                "Field": {
                  "operation": "groupby",
                  "aggregations": []
                },
                "Last *": {
                  "operation": "aggregate",
                  "aggregations": [
                    "sum"
                  ]
                }
              }
            }
          },
          {
            "id": "sortBy",
            "options": {
              "sort": [
                {
                  "field": "Last * (sum)",
                  "desc": true
                }
              ]
            }
          }
        ],
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${prom}"
            },
            "expr": "sum by (provider, price_group) (sum_over_time(llm_spend_usd[$__range]))",
            "legendFormat": "{{provider}} · {{price_group}}",
            "instant": true,
            "range": false,
            "editorMode": "code"
          }
        ],
        "id": 14,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 24
