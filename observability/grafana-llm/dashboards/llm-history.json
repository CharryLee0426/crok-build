          "y": 1
        }
      },
      {
        "type": "stat",
        "title": "Tokens",
        "description": "Input plus output tokens. Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "0",
            "color": {
              "mode": "thresholds"
