{
  "apiVersion": "dashboard.grafana.app/v1beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "llm-history",
    "annotations": {
      "grafana.app/folder": "llm-observability"
    }
  },
  "spec": {
    "title": "LLM Spend History",
    "description": "Spend, requests and tokens by day and month, from totals that recording rules copy out of the traces every 10 minutes. Starts on the day the rules were installed.",
    "tags": [
      "llm-observability",
      "history"
    ],
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "schemaVersion": 41,
    "time": {
      "from": "now-30d",
      "to": "now"
    },
    "refresh": "5m",
    "timepicker": {
      "refresh_intervals": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ]
    },
    "links": [
      {
        "type": "dashboards",
        "tags": [
          "llm-observability"
        ],
        "asDropdown": false,
        "title": "LLM dashboards",
        "includeVars": false,
        "keepTime": true,
        "targetBlank": false
      }
    ],
    "templating": {
      "list": [
        {
          "type": "datasource",
          "name": "prom",
          "label": "Metrics",
          "query": "prometheus",
          "regex": "",
          "refresh": 1,
          "hide": 0,
          "current": {
            "selected": true,
            "text": "grafanacloud-narrowgrotto289-prom",
            "value": "grafanacloud-prom"
          }
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "type": "row",
        "title": "Totals for the time range",
        "collapsed": false,
        "panels": [],
        "id": 1,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 0
        }
      },
      {
        "type": "stat",
        "title": "Spend",
        "description": "Claude (estimated at list prices) plus OpenRouter (billed). Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "noValue": "$0",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "decimals": 2
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "textMode": "value",
          "orientation": "auto",
          "wideLayout": true,
          "showPercentChange": false
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${prom}"
            },
            "expr": "sum(sum_over_time(llm_spend_usd{}[$__range]))",
            "legendFormat": "__auto",
            "instant": true,
            "range": false,
            "editorMode": "code"
          }
        ],
        "id": 2,
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 1
        }
      },
      {
        "type": "stat",
        "title": "Claude, estimated",
        "description": "Claude spend from tokens at list prices. Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "noValue": "$0",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "text",
                  "value": null
                }
              ]
            },
            "decimals": 2
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "textMode": "value",
          "orientation": "auto",
          "wideLayout": true,
          "showPercentChange": false
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${prom}"
            },
            "expr": "sum(sum_over_time(llm_spend_usd{provider=\"claude\"}[$__range]))",
            "legendFormat": "__auto",
            "instant": true,
            "range": false,
            "editorMode": "code"
          }
        ],
        "id": 3,
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 4,
          "y": 1
        }
      },
      {
        "type": "stat",
        "title": "OpenRouter, billed",
        "description": "The cost OpenRouter reported. Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "noValue": "$0",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "text",
