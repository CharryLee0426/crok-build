          }
        ],
        "id": 6,
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 16,
          "y": 1
        }
      },
      {
        "type": "stat",
        "title": "Error rate",
        "description": "Failed calls divided by all calls. Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "noValue": "0%",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.01
                },
                {
                  "color": "red",
                  "value": 0.05
                }
              ]
            },
            "decimals": 1
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center",
          "textMode": "value",
          "orientation": "auto",
          "wideLayout": true,
          "showPercentChange": false
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${prom}"
            },
            "expr": "sum(sum_over_time(llm_errors{}[$__range])) / sum(sum_over_time(llm_requests{}[$__range]))",
            "legendFormat": "__auto",
            "instant": true,
            "range": false,
            "editorMode": "code"
          }
        ],
        "id": 7,
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 20,
          "y": 1
        }
      },
      {
        "type": "row",
        "title": "By day",
        "collapsed": false,
        "panels": [],
        "id": 8,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 5
        }
      },
      {
        "type": "timeseries",
        "title": "Spend per day",
        "description": "Spend in each UTC day, by provider. The legend total is the spend over the range. Recorded every 10 minutes for the window that ended 20 minutes earlier, so the newest 20-30 minutes are not in yet. History starts when the recording rules were installed.",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 70,
              "lineWidth": 1,
              "showPoints": "never",
              "spanNulls": false,
              "barAlignment": 0,
              "gradientMode": "none",
              "stacking": {
                "mode": "normal",
                "group": "A"
              },
              "axisSoftMin": 0
            },
            "color": {
              "mode": "palette-classic"
            },
            "decimals": 2
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "sum"
            ],
            "showLegend": true,
            "sortBy": "Total",
            "sortDesc": true
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "transformations": [
          {
            "id": "renameByRegex",
            "options": {
              "regex": "^nil$",
              "renamePattern": "(not set)"
            }
          }
        ],
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "${prom}"
            },
            "expr": "sum by (provider) (sum_over_time(llm_spend_usd{}[$__interval] offset -$__interval))",
            "legendFormat": "{{provider}}",
            "instant": false,
            "range": true,
            "editorMode": "code",
            "interval": "1d"
          }
        ],
        "interval": "1d",
        "id": 9,
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 6
        }
      },
      {
        "type": "timeseries",
