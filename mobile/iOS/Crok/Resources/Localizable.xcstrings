    "This iPhone is unlinked from your account. Your computers and their sessions are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone wird von deinem Konto getrennt. Deine Computer und ihre Sitzungen sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone se desvincula de tu cuenta. Tus ordenadores y sus sesiones no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone est dissocié de votre compte. Vos ordinateurs et leurs sessions ne sont pas concernés."
          }
