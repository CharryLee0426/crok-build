    "Crok can't use the camera. Allow it in Settings to scan, or type the code below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok kann die Kamera nicht verwenden. Erlaube sie in den Einstellungen zum Scannen oder gib den Code unten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok no puede usar la cámara. Permítelo en Ajustes para escanear o escribe el código abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok ne peut pas utiliser l'appareil photo. Autorisez-le dans Réglages pour scanner, ou saisissez le code ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok はカメラを使用できません。スキャンするには「設定」で許可するか、下にコードを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok 无法使用相机。请在“设置”中允许后再扫描，或在下方输入代码。"
          }
        }
      }
    },
    "Crok follows your iPhone's language: English, 简体中文, 日本語, Español, Français or Deutsch. To choose another one for Crok only, open Settings › Apps › Crok › Language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok folgt der Sprache deines iPhone: English, 简体中文, 日本語, Español, Français oder Deutsch. Um nur für Crok eine andere zu wählen, öffne Einstellungen › Apps › Crok › Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok usa el idioma de tu iPhone: English, 简体中文, 日本語, Español, Français o Deutsch. Para elegir otro solo para Crok, abre Ajustes › Apps › Crok › Idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok suit la langue de votre iPhone : English, 简体中文, 日本語, Español, Français ou Deutsch. Pour en choisir une autre pour Crok seulement, ouvrez Réglages › Apps › Crok › Langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok は iPhone の言語（English、简体中文、日本語、Español、Français、Deutsch）に従います。Crok だけ別の言語にするには、「設定」›「アプリ」›「Crok」›「言語」を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok 跟随你 iPhone 的语言：English、简体中文、日本語、Español、Français 或 Deutsch。若只想为 Crok 选择其他语言，请打开“设置” › “App” › “Crok” › “语言”。"
          }
        }
      }
    },
