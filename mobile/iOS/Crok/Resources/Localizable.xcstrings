    "You sign in on the web. This iPhone is then linked to your account until you sign it out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du meldest dich im Web an. Danach bleibt dieses iPhone mit deinem Konto verknüpft, bis du es abmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicias sesión en la web. Después, este iPhone queda vinculado a tu cuenta hasta que cierres su sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous connectez sur le web. Cet iPhone reste ensuite associé à votre compte jusqu'à ce que vous le déconnectiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは Web で行います。その後、この iPhone はサインアウトするまでアカウントにリンクされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将在网页上登录，之后这台 iPhone 会一直关联到你的账号，直到你将它退出登录。"
          }
        }
