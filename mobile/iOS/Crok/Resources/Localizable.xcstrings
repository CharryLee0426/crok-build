    "Approve only a sign-in you just started yourself. The computer can then read your sessions and take prompts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige nur eine Anmeldung, die du gerade selbst gestartet hast. Der Computer kann dann deine Sitzungen lesen und Prompts annehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba solo un inicio de sesión que acabes de empezar tú. Después, el ordenador podrá leer tus sesiones y recibir prompts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'approuvez qu'une connexion que vous venez de lancer vous-même. L'ordinateur pourra ensuite lire vos sessions et recevoir des prompts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で今始めたサインインだけを承認してください。承認すると、そのコンピュータはセッションを読み取り、プロンプトを受け付けられるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只批准你自己刚刚发起的登录。批准后，那台电脑就能读取你的会话并接收提示词。"
          }
        }
      }
    },
