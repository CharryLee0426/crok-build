    "Every computer and phone except this iPhone is signed out. They can sign in again with a new code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Computer und Telefone außer diesem iPhone werden abgemeldet. Sie können sich mit einem neuen Code wieder anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cierra la sesión en todos los ordenadores y teléfonos salvo este iPhone. Pueden volver a iniciarla con un código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les ordinateurs et téléphones, sauf cet iPhone, sont déconnectés. Ils pourront se reconnecter avec un nouveau code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone 以外のすべてのコンピュータとスマートフォンがサインアウトされます。新しいコードで再度サインインできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除这台 iPhone 外，所有电脑和手机都会退出登录。它们可以用新的代码重新登录。"
          }
        }
      }
    },
