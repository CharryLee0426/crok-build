    "Can't reach the relay. Check your connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Relay nicht erreichbar. Prüfe deine Verbindung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede contactar con el relay. Comprueba tu conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le relais. Vérifiez votre connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リレーに接続できません。接続を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接中继，请检查网络连接。"
