        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion n'attend le code %@. Vérifiez le code sur l'ordinateur et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のサインインは待機していません。コンピュータのコードを確認してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有等待 %@ 的登录。请核对电脑上的代码后重试。"
          }
        }
      }
    },
