    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok verwendet die Kamera, um den QR-Code zu scannen, den crok remote login auf deinem Computer zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok uses the camera to scan the QR code that crok remote login shows on your computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok usa la cámara para escanear el código QR que crok remote login muestra en tu ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok utilise l'appareil photo pour scanner le QR code que crok remote login affiche sur votre ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok はコンピュータで crok remote login が表示する QR コードをスキャンするためにカメラを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok 使用相机扫描电脑上 crok remote login 显示的二维码。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok nutzt dein lokales Netzwerk nur, wenn ein Entwicklungs-Build auf ein Relay dort zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok uses your local network only when a development build points it at a relay there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok solo usa tu red local cuando una versión de desarrollo apunta a un relay que está en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok n'utilise votre réseau local que lorsqu'une version de développement pointe vers un relais qui s'y trouve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok がローカルネットワークを使うのは、開発用ビルドがそこにあるリレーを指定しているときだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当开发版本指向你本地网络中的中继时，Crok 才会使用本地网络。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
