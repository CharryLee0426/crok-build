    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok verwendet die Kamera, um den QR-Code zu scannen, den crok remote login auf deinem Computer zeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok uses the camera to scan the QR code that crok remote login shows on your computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok usa la cámara para escanear el código QR que crok remote login muestra en tu ordenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok utilise l'appareil photo pour scanner le QR code que crok remote login affiche sur votre ordinateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok はコンピュータで crok remote login が表示する QR コードをスキャンするためにカメラを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok 使用相机扫描电脑上 crok remote login 显示的二维码。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok verbindet sich mit dem eingestellten Relay-Server, der in deinem lokalen Netzwerk sein kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok connects to the relay server you set, which may be on your local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok se conecta al servidor relay que configures, que puede estar en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok se connecte au serveur relais que vous avez défini, qui peut se trouver sur votre réseau local."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok は設定したリレーサーバに接続します。サーバがローカルネットワーク上にある場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Crok 会连接你设置的中继服务器，它可能位于你的本地网络中。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
